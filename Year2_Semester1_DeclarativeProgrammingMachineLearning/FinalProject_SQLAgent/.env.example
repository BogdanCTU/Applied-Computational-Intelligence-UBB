# Optional environment overrides (copy to your shell or CI environment).
# All values are optional; defaults live in config/settings.py and settings.json.

# Must be a LOCAL host - remote hosts are rejected for data privacy.
REPORT_AGENT_OLLAMA_HOST=http://localhost:11434
REPORT_AGENT_OLLAMA_MODEL=qwen3.5:4b
# auto | native | json
REPORT_AGENT_TOOL_MODE=auto

REPORT_AGENT_DB_PATH=data/ecommerce.db
REPORT_AGENT_OUTPUT_DIR=reports
REPORT_AGENT_MAX_ROWS=1000
REPORT_AGENT_QUERY_TIMEOUT=15
REPORT_AGENT_MAX_ITERATIONS=8
REPORT_AGENT_REQUIRE_APPROVAL=true
REPORT_AGENT_LOG_LEVEL=INFO

# Override the application root (where settings.json, data/, reports/ live)
# REPORT_AGENT_HOME=/path/to/folder

