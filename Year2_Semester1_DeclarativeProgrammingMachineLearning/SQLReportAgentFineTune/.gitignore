# Python bytecode and virtual environment
__pycache__/
*.py[cod]
*$py.class
.venv/
env/
venv/

# Large Model Weights, Adapters & Checkpoints (store locally, ignore VCS)
6_Models/base/*
!6_Models/base/.gitkeep
6_Models/adapters/*
!6_Models/adapters/.gitkeep
6_Models/checkpoints/*
!6_Models/checkpoints/.gitkeep
6_Models/exported/*
!6_Models/exported/.gitkeep

# Large Databases and Raw Datasets
2_Database/raw/*
!2_Database/raw/.gitkeep
2_Database/processed/*
!2_Database/processed/.gitkeep
2_Database/synthetic/*
!2_Database/synthetic/.gitkeep

# Logs and Run Artifacts
8_Logs/*
!8_Logs/.gitkeep
*.log

# Results and Intermediate Metrics
7_Results/baseline/*
!7_Results/baseline/.gitkeep
7_Results/fine_tuned/*
!7_Results/fine_tuned/.gitkeep
7_Results/comparisons/*
!7_Results/comparisons/.gitkeep

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/

# macOS artifacts
.DS_Store
