.installed.cfg
*.egg
MANIFEST
.pybuilder/
target/

# ==============================================================================
# 5. .NET / C# COMPILATION ARTIFACTS & BINARIES (~16 MB + avoids commit bloat)
# Roslyn analyzer and C# project build directories
# ==============================================================================
[Bb]in/
[Oo]bj/
*.dll
*.exe
*.pdb
*.runtimeconfig.json
*.deps.json

# ==============================================================================
# 6. MACHINE LEARNING MODELS, WEIGHTS & CHECKPOINTS (~6.1 GB major bloat)
# Pre-trained models, fine-tuned weights, checkpoints, and LoRA adapters
# ==============================================================================
*.safetensors
*.pth
*.pt
*.ckpt
*.onnx
*.metallib
*.bin
*.h5
*.hdf5
checkpoints/
checkpoint-*/
outputs/
output/
wandb/

# ==============================================================================
# 7. SERIALIZED DATASETS & PICKLES (~100+ MB)
# Preprocessed datasets that can be recomputed from raw data scripts
# ==============================================================================
*.pkl
*.pickle
*.joblib
preprocessed_*.pkl

# ==============================================================================
# 8. LOCAL DATABASES & STORAGE ENGINES (~287 MB)
# Local runtime databases, sqlite instances, journals, and local DB clusters
