.pg/
.pgdata/
.pgdata_local/

# ==============================================================================
# 9. EXTERNAL CLONED REPOSITORIES (~2.0 GB / 76,800+ files)
# Cloned external GitHub repositories used for research / bug datasets
# ==============================================================================
**/1_Database/Repositories/
Year2_Semester1_ComputationalIntelligenceSoftwareEngineering/CISE_Project2/1_Database/Repositories/

# ==============================================================================
# 10. COMPRESSED ARCHIVES & DATA DUMPS (~60 MB)
# Compressed project backups, test zip archives, and large dumps
# ==============================================================================
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar
*.gz

