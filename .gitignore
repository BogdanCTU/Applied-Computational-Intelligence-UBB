# ==============================================================================
# MASTER .GITIGNORE FOR UNIVERSITY REPOSITORY
# Applied Computational Intelligence - UBB
#
# This file marks and excludes all unnecessary files, temporary build artifacts,
# local virtual environments, machine learning model weights, cache directories,
# local databases, IDE configurations, and operating system metadata.
# ==============================================================================

# ==============================================================================
# 1. OPERATING SYSTEM METADATA (Unnecessary OS-specific files)
# ==============================================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
[Dd]esktop.ini
$RECYCLE.BIN/

# ==============================================================================
# 2. LOCAL VIRTUAL ENVIRONMENTS & RUNTIMES (~3.6 GB unnecessary bloat)
# Recreatable via requirements.txt, pyproject.toml, or environment.yml
# ==============================================================================
.venv/
.venv*/
venv/
venv*/
env/
env*/
ENV/
env.bak/
venv.bak/
.venv_upstream/
.envrc
.pdm-python
.pdm-build/
.pixi/
__pypackages__/
.Python

# Local environment configuration & secrets
.env
.env.local
.env.*.local
*.env
!*.env.example

# ==============================================================================
# 3. PYTHON BYTECODE & COMPILATION CACHES (~600 MB)
# Temporary bytecode generated during Python execution
# ==============================================================================
__pycache__/
*.py[codz]
*$py.class
*.so
.cache
.hypothesis/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.pytype/
cython_debug/

# Unit test & coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
nosetests.xml
coverage.xml
*.cover
*.py.cover
cover/

# Jupyter Notebook & IPython caches
.ipynb_checkpoints
profile_default/
ipython_config.py

# Marimo caches
marimo/_static/
marimo/_lsp/
__marimo__/

# Streamlit local configuration
.streamlit/secrets.toml

# ==============================================================================
# 4. APPLICATION BUILD OUTPUTS & PYINSTALLER ARTIFACTS (~1.7 GB)
# Compiled binaries, bundles, and distribution directories
# ==============================================================================
build/
dist/
6_Builds/
build_tmp/
.pyinstaller_cache/
*.manifest
*.spec
*.app/
*.pkg
*.dmg

# Python packaging distribution
