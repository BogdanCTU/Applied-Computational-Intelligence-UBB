# GitHub API Configuration (Optional: set token for higher rate limits: 5000 req/hr vs 60 req/hr)
GITHUB_TOKEN=

# Storage Paths (defaults are relative to project root)
STORAGE_REPOSITORIES_PATH=data/repositories
STORAGE_DATABASE_PATH=data/database/bug_detection.db
STORAGE_MODELS_PATH=models
STORAGE_EXPORTS_PATH=exports
STORAGE_REPORTS_PATH=reports

# Roslyn Analyzer Configuration
ROSLYN_ANALYZER_PROJECT_PATH=roslyn_analyzer/RoslynAnalyzer.csproj

# Application Settings
LOG_LEVEL=INFO
DEBUG=false

